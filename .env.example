# ---------------------------------------------------------------------------
# Environment variables — copy this file to .env.local and fill in values.
# Never commit .env.local (it is already gitignored).
# ---------------------------------------------------------------------------

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Agency Starter Kit"
# Real contact inbox for the site — see config/site.ts for the placeholder
# fallback used when this is unset.
NEXT_PUBLIC_CONTACT_EMAIL=

# Analytics / third-party (add per client project)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Admin panel (/admin) — no NEXT_PUBLIC_ prefix: these must never reach the
# browser bundle. Required in production; without ADMIN_SESSION_SECRET the
# app throws on startup rather than falling back to a guessable default.
# Generate a secret with: openssl rand -base64 32
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Stripe — use TEST mode keys (dashboard.stripe.com, toggle "Test mode" on)
# for the simulation. The secret key and webhook secret must never carry the
# NEXT_PUBLIC_ prefix: only the publishable key is safe in the browser, it
# can only create tokens, never charge or read anything.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
